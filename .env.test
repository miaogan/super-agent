# ============================================================================
# 测试环境配置（test）
# 用途：CI/CD 流水线、本地集成测试、自动化测试
# 特点：使用独立测试数据库、关闭外部依赖、降低配额便于测试限流
# 用法：docker compose --env-file .env.test up -d
# ============================================================================

# ===== 环境标识 =====
ENV=test
APP_NAME=super-agent-test
# 日志级别：测试环境开 debug 便于排错
LOG_LEVEL=DEBUG

# ===== PostgreSQL 数据库地址 =====
# 测试环境可用独立数据库实例（避免污染开发数据）
POSTGRES_HOST=postgres-test
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_pass_test
POSTGRES_DB=agent_memory_test
# 或直接指定完整连接串（设置后优先于 POSTGRES_*）
# DATABASE_URL=postgresql://agent:agent_pass_test@postgres-test:5432/agent_memory_test

# ===== 后端服务地址 =====
# 后端监听地址（0.0.0.0 表示容器内所有网卡）
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 后端对外暴露地址（供前端/nginx 反代时定位后端）
# 独立部署时填后端实际可访问地址，如 http://10.0.1.10:8000
BACKEND_URL=http://backend-test:8000

# ===== 前端 / Nginx 地址 =====
# 前端 nginx 监听端口
FRONTEND_PORT=8080
# nginx 反代 API 到后端的目标地址（独立部署时填后端实际地址）
NGINX_BACKEND_URL=http://backend-test:8000
# 前端对外暴露地址（供前端调用 API 的 base URL；同源时留空走相对路径）
FRONTEND_URL=http://localhost:8080

# ===== CORS 跨域 =====
# 前端与后端不同源时必须配置
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://frontend-test

# ===== 前端构建参数 =====
# 前端构建时注入的 API 地址（同源走 nginx 反代留空；跨源填后端实际地址）
VITE_API_URL=http://localhost:8000

# ===== LLM 模型 =====
# 测试环境可用低成本模型或 mock 服务
MODEL=qwen3-4b-finetuned
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio-test

# ===== Embedding（可选）=====
EMBEDDING_MODEL=openai:text-embedding-qwen3-embedding-0.6b
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=lm-studio-test

# ===== OpenSandbox 沙箱 =====
OPENSANDBOX_DOMAIN=localhost:8080
OPENSANDBOX_API_KEY=local-dev-key-test
OPENSANDBOX_IMAGE=python:3.11-slim

# ===== 会话 / 认证 =====
USER_ID=test_user
# 测试环境用固定 secret 便于调试（生产必须改）
JWT_SECRET=test-secret-do-not-use-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===== Skill 加载 =====
SKILLS_DIR=skills

# ===== RAG（测试用 stub）=====
RAG_MODE=stub

# ===== 配额与限流（测试环境降低便于验证限流）=====
RATE_LIMIT_ENABLED=1
RATE_LIMIT_QPS=2
RATE_LIMIT_DAILY_TOKENS=10000
RATE_LIMIT_DAILY_CALLS=50

# ===== 审计日志 =====
AUDIT_RETENTION_DAYS=7

# ===== MCP 协议（测试环境不启用）=====
MCP_SERVERS=
