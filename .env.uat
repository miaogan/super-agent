# ============================================================================
# 预发布环境配置（UAT - User Acceptance Testing）
# 用途：上线前业务验证、回归测试、性能压测、给 QA/产品验收
# 特点：配置贴近生产、数据独立、可降级验证、配额放宽
# 用法：docker compose --env-file .env.uat up -d
# ============================================================================

# ===== 环境标识 =====
ENV=uat
APP_NAME=super-agent-uat
LOG_LEVEL=INFO

# ===== PostgreSQL 数据库地址 =====
# UAT 独立数据库实例（与生产完全隔离）
POSTGRES_HOST=postgres-uat
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=CHANGE_ME_UAT_STRONG_PASSWORD
POSTGRES_DB=agent_memory_uat
# DATABASE_URL=postgresql://agent:CHANGE_ME@postgres-uat:5432/agent_memory_uat

# ===== 后端服务地址 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 后端对外暴露地址（独立部署时改为后端实际可访问地址）
BACKEND_URL=http://backend-uat:8000

# ===== 前端 / Nginx 地址 =====
FRONTEND_PORT=8080
# nginx 反代目标（独立部署时填后端实际地址，如 http://10.0.2.20:8000）
NGINX_BACKEND_URL=http://backend-uat:8000
# 前端对外地址（UAT 域名场景建议填写，如 https://uat.example.com）
FRONTEND_URL=http://localhost:8080

# ===== CORS 跨域 =====
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://frontend-uat

# ===== 前端构建参数 =====
# UAT 走 nginx 同源反代，留空用 /api 相对路径
VITE_API_URL=

# ===== LLM 模型 =====
# UAT 可用与生产相同的模型（验证质量），或低成本模型（验证流程）
MODEL=anthropic:claude-sonnet-4-6
OPENAI_BASE_URL=
OPENAI_API_KEY=
# 若用 Anthropic 模型需配置
ANTHROPIC_API_KEY=sk-ant-uat-placeholder

# ===== Embedding =====
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ===== OpenSandbox 沙箱 =====
OPENSANDBOX_DOMAIN=opensandbox-uat:8080
OPENSANDBOX_API_KEY=uat-sandbox-key
OPENSANDBOX_IMAGE=python:3.11-slim

# ===== 会话 / 认证 =====
USER_ID=uat_user
# UAT 用独立 secret（生产必须再换）
JWT_SECRET=CHANGE_ME_UAT_RANDOM_SECRET_USE_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# ===== Skill 加载 =====
SKILLS_DIR=skills

# ===== RAG =====
# UAT 可对接预发布 RAG 服务
RAG_MODE=stub
# RAG_MODE=live
# RAG_BASE_URL=http://lightrag-uat:8000
# RAG_API_KEY=
RAG_TIMEOUT_SECONDS=10
RAG_TOP_K=5
RAG_FAIL_OPEN=1

# ===== 配额与限流 =====
RATE_LIMIT_ENABLED=1
RATE_LIMIT_QPS=20
RATE_LIMIT_DAILY_TOKENS=200000
RATE_LIMIT_DAILY_CALLS=500
# RATE_LIMIT_REDIS_URL=redis://redis-uat:6379/0

# ===== 审计日志 =====
AUDIT_RETENTION_DAYS=30

# ===== MCP 协议 =====
MCP_SERVERS=
