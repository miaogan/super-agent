# ===== 环境标识（三环境配置）=====
# 通过 ENV 切换 .env.prod / .env.uat / .env.test：
#   ENV=prod  → 加载项目根 .env.prod
#   ENV=uat   → 加载项目根 .env.uat
#   ENV=test  → 加载项目根 .env.test
# 不设置时回退到当前目录 .env（开发默认）
# ENV=dev
# APP_NAME=super-agent
# LOG_LEVEL=INFO

# ===== 服务地址（独立部署 / 跨主机时配置）=====
# 后端监听地址（0.0.0.0 = 容器内所有网卡）
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000
# 后端对外暴露地址（供 nginx / 前端定位后端，独立部署时填实际地址）
# BACKEND_URL=http://localhost:8000
# 前端对外暴露地址（供后端回调 / 邮件链接）
# FRONTEND_URL=http://localhost:8080

# ===== CORS 跨域（前端与后端不同源时必须配置）=====
# 逗号分隔的 origin 列表
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ===== PostgreSQL（必需：多轮对话 + 长期记忆）=====
# docker compose up -d postgres 后使用默认值即可
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_pass
POSTGRES_DB=agent_memory
# 完整连接串（可选，设置后优先生效）
# DATABASE_URL=postgresql://agent:agent_pass@localhost:5432/agent_memory

# ===== LLM 模型（必需）=====
# 本地 LM Studio（OpenAI 兼容端点）
MODEL=qwen3-4b-finetuned
OPENAI_BASE_URL=http://localhost:1234/v1
OPENAI_API_KEY=lm-studio

# 若改用云端服务，覆盖上述三行，例如：
#   MODEL=anthropic:claude-sonnet-4-6   （需 ANTHROPIC_API_KEY）
#   OPENAI_BASE_URL=
#   OPENAI_API_KEY=

# 长期记忆语义检索用的 embedding（可选，未设置则退化为关键词/时间序检索）
# 本地 LM Studio embedding 模型（init_embeddings 需要 "provider:model" 格式）
EMBEDDING_MODEL=openai:text-embedding-qwen3-embedding-0.6b
EMBEDDING_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=lm-studio

# ===== OpenSandbox 沙箱（必需：代码执行）=====
# 先启动服务端：uvx opensandbox-server init-config sandbox.toml --example docker && uvx opensandbox-server
OPENSANDBOX_DOMAIN=localhost:8080
OPENSANDBOX_API_KEY=local-dev-key
OPENSANDBOX_IMAGE=python:3.11-slim
# 沙箱空闲自动回收时间（秒）；留空则用服务端默认（约 10 分钟）
# OPENSANDBOX_TIMEOUT=1800

# ===== 会话 =====
# 长期记忆按用户隔离
USER_ID=demo_user

# ===== V1：多租户认证 =====
# JWT 密钥（生产请改成随机长串，如 openssl rand -hex 32）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== V1：Skill 加载 =====
# Skill 根目录：global 在 skills/global/，租户专属在 skills/tenants/{tenant_id}/
SKILLS_DIR=skills

# ===== V2.5-T4 RAG 对接（可选，默认 stub）=====
# 外部 LightRAG 服务地址（后续自建，本项目仅预留接口；设置后切换到 live 模式）
# RAG_MODE=stub            # stub | live
# RAG_BASE_URL=http://lightrag:8000
# RAG_API_KEY=
# RAG_TIMEOUT_SECONDS=10
# RAG_TOP_K=5
# RAG_FAIL_OPEN=1           # live 调用失败时是否降级为空结果（1=不阻塞主流程）

# ===== V2.5-T8 配额与限流（可选）=====
# RATE_LIMIT_ENABLED=0     # 默认关闭；开启后按租户计 QPS / Token / 调用次数
# RATE_LIMIT_QPS=10
# RATE_LIMIT_DAILY_TOKENS=100000
# RATE_LIMIT_DAILY_CALLS=1000
# RATE_LIMIT_REDIS_URL=     # 缺省则进程内降级（不适合多副本）

# ===== V2.5-T9 审计日志（可选）=====
# AUDIT_RETENTION_DAYS=90  # 审计记录保留期，超过则被 purge 清理

# ===== V2.5-T6 MCP 协议支持（可选）=====
# MCP_SERVERS 是 JSON 数组字符串，每项是一个 MCP server 配置
# 支持两种传输：stdio（spawn 子进程）/ http（POST JSON-RPC 到远程 server）
# 示例（stdio：本地文件系统 MCP server）：
# MCP_SERVERS='[{"name":"fs","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}]'
# 示例（http：远程 MCP server）：
# MCP_SERVERS='[{"name":"remote","transport":"http","url":"http://mcp:8000/mcp"}]'
# 可选字段：allowed_tools（白名单）/ denied_tools（黑名单）/ call_timeout / connect_timeout
# 安全策略：默认 read_only（只允许 read_/list_/search_/get_ 等查询类前缀，拒绝 write_/delete_/exec_ 等）
# MCP_SERVERS=
