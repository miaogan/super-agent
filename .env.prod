# ============================================================================
# 生产环境配置（prod）
# 用途：线上对外服务、真实用户流量、真实数据
# 特点：强安全（强密码 / 强 secret / CORS 严格）、配额保守、审计长保留
# 用法：docker compose --env-file .env.prod up -d
#
# ⚠️ 生产部署前必须修改：
#   1. POSTGRES_PASSWORD   → 强随机密码
#   2. JWT_SECRET          → openssl rand -hex 32
#   3. ANTHROPIC_API_KEY / OPENAI_API_KEY → 真实付费 key
#   4. FRONTEND_URL / BACKEND_URL / NGINX_BACKEND_URL → 实际域名/IP
#   5. CORS_ORIGINS        → 仅允许前端实际域名
# ============================================================================

# ===== 环境标识 =====
ENV=prod
APP_NAME=super-agent-prod
LOG_LEVEL=WARNING

# ===== PostgreSQL 数据库地址 =====
# 生产独立数据库实例（建议与 UAT/测试物理隔离）
POSTGRES_HOST=postgres-prod
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=CHANGE_ME_PROD_STRONG_RANDOM_PASSWORD
POSTGRES_DB=agent_memory
# DATABASE_URL=postgresql://agent:STRONG_PASS@postgres-prod:5432/agent_memory

# ===== 后端服务地址 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 后端对外暴露地址（独立部署时填后端实际可访问地址，如 http://10.0.0.10:8000）
BACKEND_URL=http://backend-prod:8000

# ===== 前端 / Nginx 地址 =====
FRONTEND_PORT=8080
# nginx 反代 API 到后端的目标地址
# 独立部署时填后端实际地址（同主机用容器名，跨主机用 IP/域名）
NGINX_BACKEND_URL=http://backend-prod:8000
# 前端对外地址（生产域名，如 https://app.example.com）
FRONTEND_URL=https://app.example.com

# ===== CORS 跨域 =====
# 生产环境只允许前端实际域名，逗号分隔多个
CORS_ORIGINS=https://app.example.com

# ===== 前端构建参数 =====
# 生产走 nginx 同源反代，留空用 /api 相对路径
VITE_API_URL=

# ===== LLM 模型 =====
MODEL=anthropic:claude-sonnet-4-6
OPENAI_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=sk-ant-PROD_REAL_KEY

# ===== Embedding =====
EMBEDDING_MODEL=openai:text-embedding-3-small
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ===== OpenSandbox 沙箱 =====
OPENSANDBOX_DOMAIN=opensandbox-prod:8080
OPENSANDBOX_API_KEY=prod-sandbox-key
OPENSANDBOX_IMAGE=python:3.11-slim
OPENSANDBOX_TIMEOUT=1800

# ===== 会话 / 认证 =====
USER_ID=prod_user
# 生产 JWT secret 必须随机且长（openssl rand -hex 32）
JWT_SECRET=CHANGE_ME_PROD_USE_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== Skill 加载 =====
SKILLS_DIR=skills

# ===== RAG =====
# 生产对接自建 LightRAG 服务
RAG_MODE=live
RAG_BASE_URL=http://lightrag-prod:8000
RAG_API_KEY=
RAG_TIMEOUT_SECONDS=10
RAG_TOP_K=5
RAG_FAIL_OPEN=1

# ===== 配额与限流 =====
RATE_LIMIT_ENABLED=1
RATE_LIMIT_QPS=10
RATE_LIMIT_DAILY_TOKENS=1000000
RATE_LIMIT_DAILY_CALLS=1000
# 生产多副本必须用 Redis（保证配额原子性）
RATE_LIMIT_REDIS_URL=redis://redis-prod:6379/0

# ===== 审计日志 =====
AUDIT_RETENTION_DAYS=90

# ===== MCP 协议 =====
# 生产按需配置 MCP server（注意安全策略）
MCP_SERVERS=
