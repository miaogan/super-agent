# ===== PostgreSQL（必需：多轮对话 + 长期记忆）=====
# docker compose up -d postgres 后使用默认值即可
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_pass
POSTGRES_DB=agent_memory
# 完整连接串（可选，设置后优先生效）
# DATABASE_URL=postgresql://agent:agent_pass@localhost:5432/agent_memory

# ===== LLM 模型（必需）=====
# init_chat_model 的 "provider:model" 格式，例如：
#   anthropic:claude-sonnet-4-6   （需 ANTHROPIC_API_KEY）
#   openai:gpt-4o                 （需 OPENAI_API_KEY）
MODEL=anthropic:claude-sonnet-4-6
ANTHROPIC_API_KEY=

# OpenAI 兼容端点（火山方舟 ARK / DeepSeek / 本地 vLLM 等）。
# 设置后 MODEL 只填模型名，例如 MODEL=doubao-seed-1-6
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OPENAI_API_KEY=

# 长期记忆语义检索用的 embedding（可选，未设置则退化为关键词/时间序检索）
# 支持 init_embeddings 格式，如 openai:text-embedding-3-small
# EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# ===== OpenSandbox 沙箱（必需：代码执行）=====
# 先启动服务端：uvx opensandbox-server init-config sandbox.toml --example docker && uvx opensandbox-server
OPENSANDBOX_DOMAIN=localhost:8080
OPENSANDBOX_API_KEY=local-dev-key
OPENSANDBOX_IMAGE=python:3.11-slim
# 沙箱空闲自动回收时间（秒）；留空则用服务端默认（约 10 分钟）
# OPENSANDBOX_TIMEOUT=1800

# ===== 会话 =====
# 长期记忆按用户隔离
USER_ID=demo_user
